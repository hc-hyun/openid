{
  "realm": "oidc-test",
  "displayName": "OIDC Local Test",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "tester",
        "description": "Role for local OIDC test users"
      }
    ]
  },
  "clients": [
    {
      "clientId": "oidc-test-app",
      "name": "OIDC Test Public App",
      "description": "Public client for Authorization Code + PKCE tests",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:8081/*",
        "http://127.0.0.1:8081/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:8081",
        "http://127.0.0.1:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*##http://localhost:8081/*##http://127.0.0.1:8081/*"
      }
    },
    {
      "clientId": "oidc-test-service",
      "name": "OIDC Test Service",
      "description": "Confidential client for Client Credentials tests",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "test-service-secret-local-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "test-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "OIDC",
      "lastName": "Tester",
      "email": "test-user@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "test-password-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "tester"
      ]
    }
  ]
}
