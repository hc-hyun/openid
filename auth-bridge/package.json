{
  "name": "auth-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provision Keycloak as an OIDC bridge between a web-only company IdP and CLI clients",
  "scripts": {
    "up": "docker compose up -d --build --wait",
    "up:ca": "docker compose -f compose.yaml -f compose.company-ca.yaml up -d --build --wait",
    "down": "docker compose down",
    "logs": "docker compose logs -f keycloak gateway",
    "setup": "npm run up && npm run provision",
    "setup:ca": "npm run up:ca && npm run provision:ca",
    "provision": "node scripts/provision.mjs",
    "provision:ca": "node scripts/provision-with-ca.mjs",
    "test": "node --test",
    "test:mock": "node mock/validate-realm.mjs",
    "test:e2e:broker": "node e2e/broker-query.mjs",
    "test:e2e:form-post": "node e2e/broker-form-post.mjs",
    "test:e2e:standalone": "node e2e/broker-standalone-form-post.mjs",
    "test:e2e": "npm run test:e2e:broker && npm run test:e2e:form-post"
  },
  "engines": {
    "node": ">=20"
  }
}
