# Copy this file to .env. Only the upstream values normally need changing.
UPSTREAM_OIDC_CLIENT_ID=replace-with-issued-client-id
UPSTREAM_OIDC_CLIENT_SECRET=replace-with-issued-client-secret

# Local Keycloak defaults used by the repository's compose.yaml.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only

# Optional non-secret overrides while /ws2/30001 is temporary.
# AUTHBRIDGE_PUBLIC_URL=https://smart-dna.sec.samsung.net/ws2/30001
# UPSTREAM_OIDC_DISCOVERY_URL=https://login.example.internal/adfs/.well-known/openid-configuration
# AUTHBRIDGE_CONFIG=config/authbridge.json
