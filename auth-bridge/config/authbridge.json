{
  "keycloak": {
    "adminUrl": "http://localhost:8080",
    "publicUrl": "https://smart-dna.sec.samsung.net/ws2/30001",
    "adminRealm": "master",
    "adminClientId": "admin-cli",
    "requestTimeoutMs": 10000
  },
  "realm": {
    "name": "authbridge",
    "displayName": "AuthBridge",
    "sslRequired": "external",
    "accessTokenLifespan": 300,
    "ssoSessionIdleTimeout": 1800,
    "ssoSessionMaxLifespan": 36000
  },
  "clients": {
    "cli": "skills-cli",
    "api": "skills-api"
  },
  "resources": {
    "mcpAudience": "https://smart-dna.sec.samsung.net/ws2/30001/mcp"
  },
  "scopes": [
    {
      "name": "skills.read",
      "description": "Read the protected Skills API"
    },
    {
      "name": "mcp.tools",
      "description": "Call protected MCP tools"
    }
  ],
  "upstream": {
    "alias": "company-oidc",
    "displayName": "Company login",
    "discoveryUrl": "https://login.example.internal/adfs/.well-known/openid-configuration",
    "defaultScope": "openid profile email",
    "clientAuthMethod": "client_secret_post",
    "responseMode": "query",
    "syncMode": "IMPORT",
    "trustEmail": false
  }
}
